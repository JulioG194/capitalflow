# Postgres connection used by apps/api (Prisma)
DATABASE_URL="postgresql://capitalflow:dev@localhost:5432/capitalflow_dev?schema=public"

# Redis connection used by apps/market-stream
REDIS_URL="redis://localhost:6379"

# RS256 JWT keypair used by apps/api for access/refresh tokens
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Finnhub API key — only apps/market-stream reads this
FINNHUB_API_KEY=""

# Base URL apps/web uses to reach apps/api (browser-visible; NEXT_PUBLIC_ prefix
# required so client components can call the auth endpoints directly)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Base URL apps/web uses to reach apps/market-stream's Socket.io /market
# namespace (browser-visible; NEXT_PUBLIC_ prefix required, spec 003 section 4).
# apps/market-stream listens on PORT 3002 by default.
NEXT_PUBLIC_MARKET_STREAM_URL="http://localhost:3002"
