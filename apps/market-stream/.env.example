# Copy this file to `.env` and fill in real values for local development.
# .env is gitignored — never commit real secrets.
#
# JWT_ACCESS_PUBLIC_KEY must match apps/api's public key (verify-only —
# market-stream must never hold the private signing key).

REDIS_URL="redis://localhost:6379"

PORT="3002"

JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----\\n"

# Free-tier key from https://finnhub.io — only this service reads it.
FINNHUB_API_KEY=""
FINNHUB_WS_URL="wss://ws.finnhub.io"
FINNHUB_REST_URL="https://finnhub.io/api/v1"

# Reconnect backoff (spec 003 section 7 / AC11)
FINNHUB_RECONNECT_BASE_MS="1000"
FINNHUB_RECONNECT_MULTIPLIER="2"
FINNHUB_RECONNECT_MAX_MS="30000"

# Outbound tick queue (AC16) and cadence (AC21/AC22)
FANOUT_QUEUE_MAX_DEPTH="500"
QUOTE_THROTTLE_MS="1000"
HEARTBEAT_INTERVAL_MS="5000"
REDIS_QUOTE_TTL_SECONDS="60"

# Must match the origin of apps/web (including port).
WEB_APP_ORIGIN="http://localhost:3010"
