# Root env var reference for CapitalFlow (spec 006, AC17).
#
# Local dev: each app also has its own `.env.example` (apps/api,
# apps/market-stream) — copy those to `.env` for `pnpm dev`. This root file
# is the full picture used to configure Vercel (apps/web) and Render
# (apps/api, apps/market-stream) env vars for deployment.
#
# Real `.env*` files are gitignored — never commit real secrets.

# --- apps/api ---

# Postgres connection (Prisma). Local: docker-compose.dev.yml default. Prod:
# Neon's *pooled* connection string with sslmode=require (infra/DEPLOY.md).
DATABASE_URL="postgresql://capitalflow:dev@localhost:5432/capitalflow_dev?schema=public"

# Redis apps/api reads cached prices from (spec 004). Same instance
# apps/market-stream writes to — see REDIS_URL below.
REDIS_URL="redis://localhost:6379"

# RS256 key pair used to sign (private) and verify (public) access tokens.
# Stored as a single line with literal "\n" sequences (real newlines are not
# valid inside a dotenv value). Generate locally:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_ACCESS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# Access token lifetime (jsonwebtoken/ms format). Optional, defaults to 15m.
JWT_ACCESS_TTL="15m"
# Refresh token lifetime, in whole days. Optional, defaults to 7.
JWT_REFRESH_TTL_DAYS="7"

# Password reset token lifetime, in whole minutes. Required, no default.
PASSWORD_RESET_TTL_MINUTES="30"

# Rate limit on POST /auth/login. Both optional (default 5 / 60s).
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="60"

# Rate limit on POST /portfolio/invest, keyed by user id. Both optional
# (default 30 / 3600s).
INVEST_RATE_LIMIT_MAX="30"
INVEST_RATE_LIMIT_WINDOW_SECONDS="3600"

# Origin of apps/web. Used for app.enableCors() (credentialed cross-origin
# requests require an explicit origin, not "*") and to build the link
# embedded in password-reset emails. In prod, set to the Vercel URL.
WEB_APP_ORIGIN="http://localhost:3000"

# Regex matching Vercel preview-deploy origins, additionally allowed by CORS
# alongside WEB_APP_ORIGIN (spec 006 AC7/AC10). OPTIONAL with NO default in
# both apps/api's and apps/market-stream's env schemas: leave unset to allow
# zero preview origins (fail closed) rather than a permissive fallback.
WEB_PREVIEW_ORIGIN_REGEX="^https://capitalflow-[a-z0-9-]+\.vercel\.app$"

# --- apps/market-stream ---
# (REDIS_URL, JWT_ACCESS_PUBLIC_KEY, WEB_APP_ORIGIN, WEB_PREVIEW_ORIGIN_REGEX
# above are shared with apps/api — same values, both services read them.)

# Free-tier key from https://finnhub.io — ONLY apps/market-stream reads this;
# apps/api must never have it (spec 006 AC20).
FINNHUB_API_KEY=""
FINNHUB_WS_URL="wss://ws.finnhub.io"
FINNHUB_REST_URL="https://finnhub.io/api/v1"

# Finnhub reconnect backoff (spec 003 section 7). All optional.
FINNHUB_RECONNECT_BASE_MS="1000"
FINNHUB_RECONNECT_MULTIPLIER="2"
FINNHUB_RECONNECT_MAX_MS="30000"

# Outbound tick fan-out tuning (spec 003 section 7). All optional.
FANOUT_QUEUE_MAX_DEPTH="500"
QUOTE_THROTTLE_MS="1000"
HEARTBEAT_INTERVAL_MS="5000"
REDIS_QUOTE_TTL_SECONDS="60"

# --- apps/web ---

# Base URL apps/web uses to reach apps/api (browser-visible; NEXT_PUBLIC_
# prefix required so client components can call auth/portfolio endpoints
# directly). Prod: the Render URL for capitalflow-api.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Base URL apps/web uses to reach apps/market-stream's Socket.io /market
# namespace (browser-visible; NEXT_PUBLIC_ prefix required, spec 003 section
# 4). Prod: the Render URL for capitalflow-stream.
NEXT_PUBLIC_MARKET_STREAM_URL="http://localhost:3002"

# --- shared / platform-provided ---

# development | test | production. Render and Vercel set this automatically
# in deployed environments.
NODE_ENV="development"

# HTTP port each backend service listens on. Render provides this
# automatically in deployed environments — only needed for local dev.
PORT="3001"
