# Copy this file to `.env` and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# PostgreSQL connection string (matches infra/docker-compose.dev.yml defaults)
DATABASE_URL="postgresql://capitalflow:dev@localhost:5432/capitalflow_dev?schema=public"

# --- JWT (RS256) ---
# PEM-encoded RSA key pair used to sign/verify access tokens. Generate a local
# dev-only pair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Store the PEM contents with literal "\n" line breaks in this single-line env var.
JWT_ACCESS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# Access token lifetime (jsonwebtoken/ms format)
JWT_ACCESS_TTL="15m"
# Refresh token lifetime, in days
JWT_REFRESH_TTL_DAYS="7"

# --- Password reset ---
# Reset token lifetime, in minutes
PASSWORD_RESET_TTL_MINUTES="30"

# --- Login rate limiting (POST /auth/login) ---
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="60"

# --- CORS / email links ---
# Origin of the apps/web frontend. Used for app.enableCors() (credentialed
# cross-origin requests require an explicit origin, not "*") and to build
# the link embedded in password-reset emails.
WEB_APP_ORIGIN="http://localhost:3000"
